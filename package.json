{
  "name": "dog-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
  "scripts": {
    "dev": "vite",
    "dev:with-emulators": "concurrently \"pnpm run start:firebase\" \"pnpm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:concise": "pnpm run test:unit -- --reporter=dot --silent",
    "test:with-output": "pnpm run test:unit -- --reporter=json --outputFile=./test-output.json",
    "test:unit": "vitest run --exclude '**/*.integration.test.tsx' --exclude '**/*.rules.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.tsx'",
    "test:rules": "pnpm dlx firebase-tools@13 emulators:exec --only firestore,storage --project dog-log-test-rules \"vitest run src/tests/firestore.rules.test.ts src/tests/storage.rules.test.ts\"",
    "test:coverage": "vitest run --exclude '**/*.integration.test.tsx' --exclude '**/*.rules.test.ts' --coverage",
    "test:watch": "vitest --exclude '**/*.integration.test.tsx' --exclude '**/*.rules.test.ts'",
    "harness": "tsx scripts/harness/cli.ts",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "preflight": "pnpm run lint && pnpm knip --no-progress && pnpm run build && pnpm run test:coverage",
    "start:firebase": "firebase emulators:start --only auth,firestore,storage",
    "prepare": "husky",
    "deploy:dev": "firebase use dev && firebase deploy --only hosting,firestore:rules,storage",
    "deploy:staging": "firebase use staging && firebase deploy --only hosting,firestore:rules,storage"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.8",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/x-date-pickers": "^8.19.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.3.0",
    "i18next": "^26.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.14.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "^10.1.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^10.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-testing-library": "^7.13.3",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.9.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
